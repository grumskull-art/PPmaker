{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PPmaker: UI",
      "type": "debugpy",
      "request": "launch",
      "module": "powerpoint_app.main",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "PPmaker: validate demo plan",
      "type": "debugpy",
      "request": "launch",
      "module": "powerpoint_app.cli",
      "args": ["validate", "examples/demo_project/slide-plan.json", "--project", "examples/demo_project"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
